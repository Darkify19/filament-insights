{
    "name": "carljanzell/filament-insights",
    "description": "Admin-built stats and chart dashboards on any Filament resource, scoped exactly like the resource's own table.",
    "type": "library",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "dashboard",
        "analytics",
        "charts"
    ],
    "homepage": "https://github.com/Darkify19/filament-insights",
    "license": "MIT",
    "authors": [
        {
            "name": "Carl Janzell",
            "email": "carl.oropesa11@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Darkify19/filament-insights/issues",
        "source": "https://github.com/Darkify19/filament-insights"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.2|^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "livewire/livewire": "^3.5|^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "CarlJanzell\\FilamentInsights\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CarlJanzell\\FilamentInsights\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CarlJanzell\\FilamentInsights\\InsightsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint"
    }
}
